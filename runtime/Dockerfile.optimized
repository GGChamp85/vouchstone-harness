# Optimized Dockerfile with multi-stage build to reduce final image size
#
# Standard build context: this file's own directory.
#   docker build -f Dockerfile.optimized -t vouchstone/runtime .
# requirements.txt installs vouchstone-sdk from PyPI as a normal (non-
# editable) dependency -- no SDK source needs to ship in the final image,
# unlike the old editable-install convention (from before the SDK was
# published).
#
# Builder installs into a venv rather than `pip install --user`: a --user
# install resolves its target directory from $HOME at *install* time
# (/root, since the builder stage runs as root) but Python resolves
# site.getusersitepackages() from $HOME again at *import* time -- and the
# final stage runs as the non-root `vouchstone` user, whose $HOME is
# /home/vouchstone, not /root, so `import vouchstone_sdk` fails with
# ModuleNotFoundError even though /root/.local was copied in (verified by
# actually running the built image, not just building it). A venv's
# absolute paths don't depend on which user or $HOME is active, so it
# doesn't have this failure mode.
FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --progress-bar off -r requirements.txt

# Final stage - minimal runtime image
FROM python:3.11-slim

WORKDIR /app

# Install only runtime dependencies (curl for healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy the venv from the builder -- readable by any user, no $HOME
# dependency at import time.
COPY --from=builder /opt/venv /opt/venv

# Create non-root user
RUN useradd -m -u 1000 vouchstone

# Copy application files
COPY --chown=vouchstone:vouchstone src/ ./src/
COPY --chown=vouchstone:vouchstone config/ ./config/

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Switch to non-root user
USER vouchstone

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["python", "-m", "src.main"]
